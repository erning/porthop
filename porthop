#!/usr/bin/env bash
set -euo pipefail

readonly DEFAULT_URL=https://porthop.erning.workers.dev DEFAULT_ENV_FILE=/etc/porthop.env
readonly PORT_MIN=20000 PORT_MAX=59999
readonly NFT_FAMILY=inet NFT_TABLE=porthop NFT_BASE_CHAIN=prerouting
readonly COMMENT_PREFIX=porthop: LOCK_FILE=/run/porthop-forward.lock
readonly PROGRAM_NAME="${0##*/}"
VERBOSE=0

usage() {
    cat >&2 <<EOF
Usage:
  $PROGRAM_NAME forward set <name> --dport <port> --port <port> [--port <port> ...]
  $PROGRAM_NAME forward get <name>
  $PROGRAM_NAME forward del <name>
  $PROGRAM_NAME forward list
  $PROGRAM_NAME coordinator set <name> --port <port> [<options>]
  $PROGRAM_NAME coordinator fail <name> --port <port> [<options>]
  $PROGRAM_NAME coordinator get <name> [<options>]
  $PROGRAM_NAME coordinator del <name> [<options>]
  $PROGRAM_NAME coordinator list [<options>]
  $PROGRAM_NAME server <name> <interface> [<options>]
  $PROGRAM_NAME client <name> <interface> [<options>]

Coordinator options:
  --env <path>  --url <url>  --token-file <path>  --json  --verbose

Server options:
  --env <path>  --url <url>  --token-file <path>  --dry-run  --verbose

Client options:
  --env <path>  --stale-after <seconds>  --url <url>  --token-file <path>
  --dry-run  --verbose
EOF
}

die() { local status=$1; shift; printf 'Error: %s\n' "$*" >&2; exit "$status"; }
verbose() { (( VERBOSE )) && printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2 || true; }
need_value() { (( $# >= 2 )) || die 2 "$1 requires a value."; }
require_command() { command -v "$1" >/dev/null 2>&1 || die 1 "$1 was not found."; }
validate_name() { [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]] || die 2 'invalid name.'; }
validate_iface() { [[ $1 =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || die 2 'invalid WireGuard interface.'; }
validate_port() { [[ $1 =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )) || die 2 "invalid port: $1"; }
validate_nonnegative() { [[ $2 =~ ^[0-9]+$ ]] || die 2 "invalid $1: $2"; }

load_env() {
    local env_file=$DEFAULT_ENV_FILE env_set=0
    ENV_ARGS=()
    while (( $# )); do
        if [[ $1 == --env ]]; then
            need_value "$@"
            (( ! env_set )) || die 2 '--env may only be specified once.'
            env_file=$2
            env_set=1
            shift 2
        else
            ENV_ARGS+=("$1")
            shift
        fi
    done
    if [[ -e $env_file ]]; then
        [[ -f $env_file && -r $env_file ]] || die 1 "cannot read environment file: $env_file"
        # shellcheck source=/dev/null
        source "$env_file"
    elif (( env_set )); then
        die 1 "cannot read environment file: $env_file"
    fi
}

lock_nft() {
    (( EUID == 0 )) || die 1 'this command must be run as root.'
    require_command nft
    require_command flock
    require_command sha256sum
    exec 9>"$LOCK_FILE"
    flock -x 9
}

chain_for_name() {
    local digest
    digest=$(printf '%s' "$1" | sha256sum)
    printf 'ph_%s\n' "${digest:0:20}"
}

ensure_table() {
    if ! nft list table "$NFT_FAMILY" "$NFT_TABLE" >/dev/null 2>&1; then
        printf 'add table %s %s\nadd chain %s %s %s { type nat hook prerouting priority dstnat; policy accept; }\n' \
            "$NFT_FAMILY" "$NFT_TABLE" "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" | nft -f -
    elif ! nft list chain "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" >/dev/null 2>&1; then
        printf 'add chain %s %s %s { type nat hook prerouting priority dstnat; policy accept; }\n' \
            "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" | nft -f -
    fi
}

list_refs() {
    nft -a list chain "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" 2>/dev/null |
        awk -v prefix="$COMMENT_PREFIX" '
            {
                chain = name = handle = ""
                for (i = 1; i <= NF; i++) {
                    if ($i == "jump") chain = $(i + 1)
                    if ($i == "comment") {
                        name = $(i + 1)
                        gsub(/^"|"$/, "", name)
                    }
                    if ($i == "handle") handle = $(i + 1)
                }
                if (index(name, prefix) == 1)
                    print substr(name, length(prefix) + 1), chain, handle
            }
        '
}

list_rules() {
    nft list chain "$NFT_FAMILY" "$NFT_TABLE" "$1" 2>/dev/null |
        awk '
            /udp dport [0-9]+/ && /redirect to/ {
                source = target = ""
                for (i = 1; i <= NF; i++) {
                    if ($i == "dport") source = $(i + 1)
                    if ($i == "redirect" && $(i + 1) == "to") {
                        target = $(i + 2)
                        if (target == ":") target = $(i + 3)
                        sub(/^:/, "", target)
                    }
                }
                if (source != "" && target != "") print source, target
            }
        '
}

list_rule_handles() {
    nft -a list chain "$NFT_FAMILY" "$NFT_TABLE" "$1" 2>/dev/null |
        awk '
            /udp dport [0-9]+/ && /redirect to/ && /handle [0-9]+/ {
                source = target = handle = ""
                for (i = 1; i <= NF; i++) {
                    if ($i == "dport") source = $(i + 1)
                    if ($i == "redirect" && $(i + 1) == "to") {
                        target = $(i + 2)
                        if (target == ":") target = $(i + 3)
                        sub(/^:/, "", target)
                    }
                    if ($i == "handle") handle = $(i + 1)
                }
                if (source != "" && target != "" && handle != "")
                    print source, target, handle
            }
        '
}

find_ref() {
    local wanted=$1 name chain handle
    REF_CHAIN= REF_HANDLE=
    while read -r name chain handle; do
        [[ $name == "$wanted" ]] || continue
        REF_CHAIN=$chain
        REF_HANDLE=$handle
        return 0
    done < <(list_refs)
    return 1
}

read_forward() {
    local name=$1 source target
    FORWARD_DPORT=
    FORWARD_PORTS=()
    find_ref "$name" || return 1
    while read -r source target; do
        FORWARD_PORTS+=("$source")
        if [[ -z $FORWARD_DPORT ]]; then
            FORWARD_DPORT=$target
        elif [[ $FORWARD_DPORT != "$target" ]]; then
            die 1 "inconsistent target ports for $name."
        fi
    done < <(list_rules "$REF_CHAIN")
    [[ -n $FORWARD_DPORT && ${#FORWARD_PORTS[@]} -gt 0 ]] || die 1 "forwarding group is empty: $name"
}

print_forward() {
    local name=$1
    shift
    local dport=$1
    shift
    printf '%s: %s <- %s\n' "$name" "$dport" "$*"
}

clear_conntrack() {
    local dport=$1
    shift
    local port output status
    command -v conntrack >/dev/null 2>&1 || return 0
    for port in "$@"; do
        status=0
        output=$(conntrack -D -p udp --orig-port-dst "$port" --reply-port-src "$dport" 2>&1) || status=$?
        if (( status != 0 )) && [[ $output != *'0 flow entries have been deleted'* ]]; then
            printf 'Warning: failed to delete UDP conntrack entries for %s -> %s: %s\n' \
                "$port" "$dport" "$output" >&2
        fi
    done
}

set_command() {
    (( $# >= 2 )) || { usage; exit 2; }
    local name=$2 dport= port own_chain= chain batch= other_name other_chain ref_handle
    local source target rule_handle rule_count
    local old_dport= old_ports_text= ports_text=
    local -a ports=() old_ports=() replaced_ports=() replaced_targets=()
    local -A seen=() removed_by_chain=() rules_by_chain=() refs_by_chain=()
    shift 2
    validate_name "$name"

    while (( $# )); do
        case $1 in
            --dport)
                need_value "$@"
                [[ -z $dport ]] || die 2 '--dport may only be specified once.'
                dport=$2
                shift 2
                ;;
            --port)
                need_value "$@"
                validate_port "$2"
                [[ -v seen[$2] ]] || { seen[$2]=1; ports+=("$2"); }
                shift 2
                ;;
            *) die 2 "unknown set option: $1" ;;
        esac
    done

    [[ -n $dport ]] || die 2 'set requires --dport.'
    validate_port "$dport"
    (( ${#ports[@]} > 0 )) || die 2 'set requires at least one --port.'
    lock_nft
    ensure_table

    if read_forward "$name"; then
        old_dport=$FORWARD_DPORT
        old_ports=("${FORWARD_PORTS[@]}")
        old_ports_text=${old_ports[*]}
        own_chain=$REF_CHAIN
    fi
    ports_text=${ports[*]}
    if [[ $old_dport == "$dport" && $old_ports_text == "$ports_text" ]]; then
        print_forward "$name" "$dport" "${ports[@]}"
        return
    fi

    while read -r other_name other_chain ref_handle; do
        [[ $other_name == "$name" ]] && continue
        rule_count=0
        while read -r source target rule_handle; do
            (( rule_count += 1 ))
            for port in "${ports[@]}"; do
                [[ $source != "$port" ]] || {
                    batch+="delete rule $NFT_FAMILY $NFT_TABLE $other_chain handle $rule_handle"$'\n'
                    (( removed_by_chain[$other_chain] += 1 ))
                    replaced_ports+=("$source")
                    replaced_targets+=("$target")
                }
            done
        done < <(list_rule_handles "$other_chain")
        rules_by_chain[$other_chain]=$rule_count
        refs_by_chain[$other_chain]=$ref_handle
    done < <(list_refs)

    for other_chain in "${!removed_by_chain[@]}"; do
        if (( removed_by_chain[$other_chain] == rules_by_chain[$other_chain] )); then
            batch+="delete rule $NFT_FAMILY $NFT_TABLE $NFT_BASE_CHAIN handle ${refs_by_chain[$other_chain]}"$'\n'
            batch+="delete chain $NFT_FAMILY $NFT_TABLE $other_chain"$'\n'
        fi
    done

    chain=$(chain_for_name "$name")
    if [[ -n $own_chain ]]; then
        [[ $own_chain == "$chain" ]] || die 1 "inconsistent nftables chain for $name."
        batch+="flush chain $NFT_FAMILY $NFT_TABLE $chain"$'\n'
    else
        nft list chain "$NFT_FAMILY" "$NFT_TABLE" "$chain" >/dev/null 2>&1 &&
            die 1 "nftables chain collision for $name."
        batch+="add chain $NFT_FAMILY $NFT_TABLE $chain"$'\n'
        batch+="add rule $NFT_FAMILY $NFT_TABLE $NFT_BASE_CHAIN jump $chain comment \"$COMMENT_PREFIX$name\""$'\n'
    fi
    for port in "${ports[@]}"; do
        batch+="add rule $NFT_FAMILY $NFT_TABLE $chain udp dport $port redirect to :$dport"$'\n'
    done
    printf '%s' "$batch" | nft -f -

    [[ -z $old_dport ]] || clear_conntrack "$old_dport" "${old_ports[@]}"
    for (( rule_count=0; rule_count<${#replaced_ports[@]}; rule_count++ )); do
        clear_conntrack "${replaced_targets[$rule_count]}" "${replaced_ports[$rule_count]}"
    done
    print_forward "$name" "$dport" "${ports[@]}"
}

get_command() {
    (( $# == 2 )) || { usage; exit 2; }
    validate_name "$2"
    lock_nft
    nft list chain "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" >/dev/null 2>&1 ||
        die 1 "forwarding group not found: $2"
    read_forward "$2" || die 1 "forwarding group not found: $2"
    print_forward "$2" "$FORWARD_DPORT" "${FORWARD_PORTS[@]}"
}

del_command() {
    (( $# == 2 )) || { usage; exit 2; }
    local name=$2 dport chain handle
    local -a ports=()
    validate_name "$name"
    lock_nft
    nft list chain "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" >/dev/null 2>&1 ||
        die 1 "forwarding group not found: $name"
    read_forward "$name" || die 1 "forwarding group not found: $name"
    dport=$FORWARD_DPORT
    ports=("${FORWARD_PORTS[@]}")
    chain=$REF_CHAIN
    handle=$REF_HANDLE
    printf 'delete rule %s %s %s handle %s\ndelete chain %s %s %s\n' \
        "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" "$handle" \
        "$NFT_FAMILY" "$NFT_TABLE" "$chain" | nft -f -
    clear_conntrack "$dport" "${ports[@]}"
}

list_command() {
    (( $# == 1 )) || { usage; exit 2; }
    local name chain handle source target dport
    local -a ports=()
    lock_nft
    nft list chain "$NFT_FAMILY" "$NFT_TABLE" "$NFT_BASE_CHAIN" >/dev/null 2>&1 || return 0
    while read -r name chain handle; do
        dport=
        ports=()
        while read -r source target; do
            ports+=("$source")
            dport=$target
        done < <(list_rules "$chain")
        [[ -z $dport ]] || print_forward "$name" "$dport" "${ports[@]}"
    done < <(list_refs | sort -k1,1)
}

resolve_token() {
    local file=${1:-${PORTHOP_TOKEN_FILE-}} token
    if [[ -n $file ]]; then
        [[ -r $file ]] || die 1 "cannot read token file: $file"
        token=$(<"$file")
    else
        token=${PORTHOP_TOKEN-}
    fi
    [[ -n $token ]] || die 2 'token is required; set PORTHOP_TOKEN_FILE or PORTHOP_TOKEN.'
    [[ $token != *$'\n'* && $token != *$'\r'* ]] || die 2 'token must be a single line.'
    printf '%s' "$token"
}

require_json_tool() {
    if command -v jq >/dev/null 2>&1; then
        JSON_TOOL=jq
    elif command -v jsonfilter >/dev/null 2>&1; then
        JSON_TOOL=jsonfilter
    else
        die 1 'jq or jsonfilter was not found.'
    fi
}

json_field() {
    local data=$1 field=$2
    if [[ $JSON_TOOL == jq ]]; then
        jq -er ".$field // empty" <<<"$data"
    else
        jsonfilter -s "$data" -e "@.$field"
    fi
}

print_channel() {
    local data=$1 name port failed
    name=$(json_field "$data" name) || die 1 'Coordinator returned invalid channel state.'
    port=$(json_field "$data" port) || die 1 'Coordinator returned invalid channel state.'
    failed=$(json_field "$data" failed_port 2>/dev/null || true)
    printf '%s: port %s, failed %s\n' "$name" "$port" "${failed:--}"
}

parse_coordinator_options() {
    local allow_port=$1
    shift
    load_env "$@"
    set -- "${ENV_ARGS[@]}"
    COORD_URL= COORD_TOKEN_FILE= COORD_PORT= COORD_JSON=0
    VERBOSE=0
    while (( $# )); do
        case $1 in
            --port)
                (( allow_port )) || die 2 "unknown option: $1"
                need_value "$@"
                [[ -z $COORD_PORT ]] || die 2 '--port may only be specified once.'
                validate_port "$2"
                COORD_PORT=$2
                shift 2
                ;;
            --url)
                need_value "$@"
                [[ -z $COORD_URL ]] || die 2 '--url may only be specified once.'
                COORD_URL=$2
                shift 2
                ;;
            --token-file)
                need_value "$@"
                [[ -z $COORD_TOKEN_FILE ]] || die 2 '--token-file may only be specified once.'
                COORD_TOKEN_FILE=$2
                shift 2
                ;;
            --json) COORD_JSON=1; shift ;;
            --verbose) VERBOSE=1; shift ;;
            *) die 2 "unknown option: $1" ;;
        esac
    done
}

prepare_coordinator() {
    require_command curl
    COORD_URL=${COORD_URL:-${PORTHOP_URL:-$DEFAULT_URL}}
    COORD_TOKEN=$(resolve_token "$COORD_TOKEN_FILE")
}

coordinator_http() {
    local method=$1 path=$2 payload=${3-} response
    local -a args=(--silent --show-error --connect-timeout 10 --max-time 30
        --request "$method" --header "Authorization: Bearer $COORD_TOKEN"
        --header 'Accept: application/json' --write-out $'\n%{http_code}')
    [[ -z $payload ]] || args+=(--header 'Content-Type: application/json' --data "$payload")
    verbose "HTTP $method ${COORD_URL%/}$path"
    response=$(curl "${args[@]}" "${COORD_URL%/}$path") || die 1 "failed to contact Coordinator."
    HTTP_STATUS=${response##*$'\n'}
    HTTP_BODY=${response%$'\n'*}
    verbose "HTTP $HTTP_STATUS: $method $path"
}

coordinator_request() {
    coordinator_http "$@"
    [[ $HTTP_STATUS =~ ^2[0-9][0-9]$ ]] ||
        die 1 "Coordinator returned HTTP $HTTP_STATUS${HTTP_BODY:+: $HTTP_BODY}"
}

coordinator_set_command() {
    (( $# >= 2 )) || { usage; exit 2; }
    local name=$2
    shift 2
    validate_name "$name"
    parse_coordinator_options 1 "$@"
    [[ -n $COORD_PORT ]] || die 2 'coordinator set requires --port.'
    prepare_coordinator
    coordinator_request PUT "/v1/channels/$name" "{\"port\":$COORD_PORT}"
    if (( COORD_JSON )); then printf '%s\n' "$HTTP_BODY"; else require_json_tool; print_channel "$HTTP_BODY"; fi
}

coordinator_fail_command() {
    (( $# >= 2 )) || { usage; exit 2; }
    local name=$2
    shift 2
    validate_name "$name"
    parse_coordinator_options 1 "$@"
    [[ -n $COORD_PORT ]] || die 2 'coordinator fail requires --port.'
    prepare_coordinator
    coordinator_request PUT "/v1/channels/$name/failure" "{\"port\":$COORD_PORT}"
    if (( COORD_JSON )); then printf '%s\n' "$HTTP_BODY"; else require_json_tool; print_channel "$HTTP_BODY"; fi
}

coordinator_get_command() {
    (( $# >= 2 )) || { usage; exit 2; }
    local name=$2
    shift 2
    validate_name "$name"
    parse_coordinator_options 0 "$@"
    prepare_coordinator
    coordinator_request GET "/v1/channels/$name"
    if (( COORD_JSON )); then printf '%s\n' "$HTTP_BODY"; else require_json_tool; print_channel "$HTTP_BODY"; fi
}

coordinator_del_command() {
    (( $# >= 2 )) || { usage; exit 2; }
    local name=$2
    shift 2
    validate_name "$name"
    parse_coordinator_options 0 "$@"
    prepare_coordinator
    coordinator_request DELETE "/v1/channels/$name"
    if (( COORD_JSON )); then printf '{"name":"%s","deleted":true}\n' "$name"; else printf '%s: deleted\n' "$name"; fi
}

coordinator_list_command() {
    (( $# >= 1 )) || { usage; exit 2; }
    shift
    parse_coordinator_options 0 "$@"
    prepare_coordinator
    coordinator_request GET /v1/channels
    if (( COORD_JSON )); then
        printf '%s\n' "$HTTP_BODY"
        return
    fi
    require_json_tool
    if [[ $JSON_TOOL == jq ]]; then
        local channel
        while IFS= read -r channel; do print_channel "$channel"; done < <(jq -c '.channels[]' <<<"$HTTP_BODY")
    else
        local name
        while IFS= read -r name; do
            coordinator_request GET "/v1/channels/$name"
            print_channel "$HTTP_BODY"
        done < <(jsonfilter -s "$HTTP_BODY" -e '@.channels[*].name')
    fi
}

parse_server_options() {
    SERVER_URL= SERVER_TOKEN_FILE= SERVER_DRY_RUN=0
    VERBOSE=0
    while (( $# )); do
        case $1 in
            --url)
                need_value "$@"
                [[ -z $SERVER_URL ]] || die 2 '--url may only be specified once.'
                SERVER_URL=$2
                shift 2
                ;;
            --token-file)
                need_value "$@"
                [[ -z $SERVER_TOKEN_FILE ]] || die 2 '--token-file may only be specified once.'
                SERVER_TOKEN_FILE=$2
                shift 2
                ;;
            --dry-run) SERVER_DRY_RUN=1; shift ;;
            --verbose) VERBOSE=1; shift ;;
            *) die 2 "unknown server option: $1" ;;
        esac
    done
}

read_local_forward() {
    local name=$1 output
    local -a fields=()
    LOCAL_DPORT=
    LOCAL_PORTS=()
    output=$("$0" forward get "$name" 2>/dev/null) || return 1
    read -r -a fields <<<"$output"
    (( ${#fields[@]} >= 4 )) || return 1
    [[ ${fields[0]} == "$name:" && ${fields[2]} == '<-' ]] || return 1
    validate_port "${fields[1]}"
    LOCAL_DPORT=${fields[1]}
    LOCAL_PORTS=("${fields[@]:3}")
    local port
    for port in "${LOCAL_PORTS[@]}"; do validate_port "$port"; done
}

select_public_port() {
    local value port line i excluded
    local -a fields=()
    local -A unavailable=()
    require_command hexdump

    for excluded in "$@"; do [[ -z $excluded ]] || unavailable[$excluded]=1; done
    while IFS= read -r line; do
        read -r -a fields <<<"$line"
        for (( i=3; i<${#fields[@]}; i++ )); do unavailable[${fields[i]}]=1; done
    done < <("$0" forward list)

    for (( i=0; i<1000; i++ )); do
        value=$(hexdump -n 2 -e '1/2 "%u"' /dev/urandom)
        port=$(( PORT_MIN + value % (PORT_MAX - PORT_MIN + 1) ))
        if [[ ! -v unavailable[$port] ]]; then
            printf '%s\n' "$port"
            return
        fi
    done
    die 1 'failed to find an available public port.'
}

server_forward_set() {
    local name=$1 dport=$2
    shift 2
    local port output
    local -a args=(forward set "$name" --dport "$dport")
    for port in "$@"; do args+=(--port "$port"); done
    verbose "forward set $name: $dport <- $*"
    (( ! SERVER_DRY_RUN )) || { verbose 'dry run: skipped forward update'; return; }
    output=$("$0" "${args[@]}" 2>&1) || die 1 "failed to update forwarding: $output"
}

server_publish_port() {
    local name=$1 port=$2
    verbose "publishing Coordinator port: $port"
    (( ! SERVER_DRY_RUN )) || { verbose 'dry run: skipped Coordinator update'; return; }
    coordinator_request PUT "/v1/channels/$name" "{\"port\":$port}"
}

server_command() {
    shift
    load_env "$@"
    set -- "${ENV_ARGS[@]}"
    (( $# >= 2 )) || { usage; exit 2; }
    local name=$1 iface=$2
    shift 2
    validate_name "$name"
    validate_iface "$iface"
    parse_server_options "$@"
    (( EUID == 0 )) || die 1 'this command must be run as root.'
    require_command wg
    require_command curl
    require_json_tool

    verbose "reading WireGuard listen port from $iface"
    local dport
    dport=$(wg show "$iface" listen-port 2>/dev/null) ||
        die 1 "WireGuard interface is not running: $iface"
    validate_port "$dport"
    verbose "WireGuard listen port: $dport"

    COORD_URL=${SERVER_URL:-${PORTHOP_URL:-$DEFAULT_URL}}
    COORD_TOKEN=$(resolve_token "$SERVER_TOKEN_FILE")

    local coordinator_exists=0 current_port= failed_port=
    verbose "reading Coordinator channel: $name"
    coordinator_http GET "/v1/channels/$name"
    case $HTTP_STATUS in
        200)
            coordinator_exists=1
            current_port=$(json_field "$HTTP_BODY" port) ||
                die 1 'Coordinator returned invalid channel state.'
            validate_port "$current_port"
            failed_port=$(json_field "$HTTP_BODY" failed_port 2>/dev/null || true)
            [[ -z $failed_port ]] || validate_port "$failed_port"
            verbose "Coordinator state: port $current_port, failed ${failed_port:--}"
            ;;
        404) verbose 'Coordinator channel does not exist' ;;
        *) die 1 "Coordinator returned HTTP $HTTP_STATUS${HTTP_BODY:+: $HTTP_BODY}" ;;
    esac

    local local_exists=0
    if read_local_forward "$name"; then
        local_exists=1
        verbose "local forwarding: $LOCAL_DPORT <- ${LOCAL_PORTS[*]}"
    else
        verbose 'local forwarding is missing or invalid'
    fi

    local new_port matches=0
    if (( ! coordinator_exists )); then
        new_port=$(select_public_port)
        verbose "selected initial public port: $new_port"
        server_forward_set "$name" "$dport" "$new_port"
        server_publish_port "$name" "$new_port"
        if (( SERVER_DRY_RUN )); then
            printf '%s: would initialize port %s -> %s:%s\n' "$name" "$new_port" "$iface" "$dport"
        else
            printf '%s: port %s -> %s:%s\n' "$name" "$new_port" "$iface" "$dport"
        fi
        return
    fi

    if [[ $current_port == "$failed_port" ]]; then
        verbose 'current public port was reported unavailable'
        new_port=$(select_public_port "$current_port" "$failed_port")
        verbose "selected replacement public port: $new_port"
        server_forward_set "$name" "$dport" "$current_port" "$new_port"
        server_publish_port "$name" "$new_port"
        if (( SERVER_DRY_RUN )); then
            printf '%s: would switch %s -> %s, %s:%s\n' "$name" "$current_port" "$new_port" "$iface" "$dport"
        else
            printf '%s: %s -> %s, %s:%s\n' "$name" "$current_port" "$new_port" "$iface" "$dport"
        fi
        return
    fi

    if (( local_exists )) && [[ $LOCAL_DPORT == "$dport" && ${#LOCAL_PORTS[@]} == 1 && ${LOCAL_PORTS[0]} == "$current_port" ]]; then
        matches=1
    fi
    if (( matches )); then
        verbose 'local forwarding already matches Coordinator state'
    else
        verbose 'reconciling local forwarding with Coordinator state'
        server_forward_set "$name" "$dport" "$current_port"
        server_publish_port "$name" "$current_port"
    fi
    if (( SERVER_DRY_RUN && ! matches )); then
        printf '%s: would reconcile port %s -> %s:%s\n' "$name" "$current_port" "$iface" "$dport"
    else
        printf '%s: port %s -> %s:%s\n' "$name" "$current_port" "$iface" "$dport"
    fi
}

parse_client_options() {
    CLIENT_URL= CLIENT_TOKEN_FILE=
    CLIENT_STALE_AFTER=${PORTHOP_STALE_AFTER:-300} CLIENT_STALE_SET=0 CLIENT_DRY_RUN=0
    validate_nonnegative stale-after "$CLIENT_STALE_AFTER"
    VERBOSE=0
    while (( $# )); do
        case $1 in
            --stale-after)
                need_value "$@"
                (( ! CLIENT_STALE_SET )) || die 2 '--stale-after may only be specified once.'
                validate_nonnegative stale-after "$2"
                CLIENT_STALE_AFTER=$2
                CLIENT_STALE_SET=1
                shift 2
                ;;
            --url)
                need_value "$@"
                [[ -z $CLIENT_URL ]] || die 2 '--url may only be specified once.'
                CLIENT_URL=$2
                shift 2
                ;;
            --token-file)
                need_value "$@"
                [[ -z $CLIENT_TOKEN_FILE ]] || die 2 '--token-file may only be specified once.'
                CLIENT_TOKEN_FILE=$2
                shift 2
                ;;
            --dry-run) CLIENT_DRY_RUN=1; shift ;;
            --verbose) VERBOSE=1; shift ;;
            *) die 2 "unknown client option: $1" ;;
        esac
    done
}

client_command() {
    shift
    load_env "$@"
    set -- "${ENV_ARGS[@]}"
    (( $# >= 2 )) || { usage; exit 2; }
    local name=$1 iface=$2
    shift 2
    validate_name "$name"
    validate_iface "$iface"
    parse_client_options "$@"
    require_command wg
    require_command curl
    require_json_tool

    COORD_URL=${CLIENT_URL:-${PORTHOP_URL:-$DEFAULT_URL}}
    COORD_TOKEN=$(resolve_token "$CLIENT_TOKEN_FILE")

    verbose "reading Coordinator channel: $name"
    coordinator_request GET "/v1/channels/$name"
    local wanted_port
    wanted_port=$(json_field "$HTTP_BODY" port) ||
        die 1 'Coordinator returned invalid channel state.'
    validate_port "$wanted_port"
    verbose "Coordinator current port: $wanted_port"

    verbose "reading WireGuard peers from $iface"
    local peers_output
    local -a peers=()
    peers_output=$(wg show "$iface" peers 2>/dev/null) ||
        die 1 "WireGuard interface is not running: $iface"
    read -r -a peers <<<"$peers_output"
    (( ${#peers[@]} == 1 )) ||
        die 1 "WireGuard interface must have exactly one peer: $iface"
    local peer=${peers[0]}
    verbose "WireGuard peer: $peer"

    local endpoint_output endpoint_peer endpoint extra endpoint_host actual_port
    endpoint_output=$(wg show "$iface" endpoints 2>/dev/null) ||
        die 1 "cannot read WireGuard endpoint: $iface"
    read -r endpoint_peer endpoint extra <<<"$endpoint_output"
    [[ $endpoint_peer == "$peer" && -n $endpoint && -z ${extra-} && $endpoint != '(none)' ]] ||
        die 1 "WireGuard peer does not have a valid endpoint: $iface"
    if [[ $endpoint =~ ^(.+):([0-9]+)$ ]]; then
        endpoint_host=${BASH_REMATCH[1]}
        actual_port=${BASH_REMATCH[2]}
    else
        die 1 "WireGuard peer does not have a valid endpoint: $iface"
    fi
    validate_port "$actual_port"
    verbose "WireGuard endpoint: $endpoint_host:$actual_port"

    if [[ $actual_port != "$wanted_port" ]]; then
        verbose "updating WireGuard endpoint port: $actual_port -> $wanted_port"
        if (( CLIENT_DRY_RUN )); then
            verbose 'dry run: skipped WireGuard endpoint update'
            printf '%s: would update endpoint %s -> %s, %s\n' "$name" "$actual_port" "$wanted_port" "$iface"
        else
            wg set "$iface" peer "$peer" endpoint "$endpoint_host:$wanted_port" ||
                die 1 'failed to update WireGuard endpoint.'
            printf '%s: endpoint %s -> %s, %s\n' "$name" "$actual_port" "$wanted_port" "$iface"
        fi
        return
    fi

    verbose "reading latest WireGuard handshake from $iface"
    local handshake_output handshake_peer handshake extra_handshake now age stale=0
    handshake_output=$(wg show "$iface" latest-handshakes 2>/dev/null) ||
        die 1 "cannot read WireGuard handshake: $iface"
    read -r handshake_peer handshake extra_handshake <<<"$handshake_output"
    [[ $handshake_peer == "$peer" && $handshake =~ ^[0-9]+$ && -z ${extra_handshake-} ]] ||
        die 1 "WireGuard returned an invalid handshake: $iface"
    now=$(date +%s)
    if (( handshake == 0 )); then
        stale=1
        verbose 'WireGuard peer has never completed a handshake'
    else
        (( handshake <= now )) && age=$(( now - handshake )) || age=0
        verbose "latest handshake age: $age seconds"
        (( age > CLIENT_STALE_AFTER )) && stale=1
    fi

    if (( ! stale )); then
        printf '%s: port %s, handshake age %s seconds\n' "$name" "$actual_port" "$age"
        return
    fi

    verbose "reporting public port unavailable: $actual_port"
    if (( CLIENT_DRY_RUN )); then
        verbose 'dry run: skipped failure report'
        if (( handshake == 0 )); then
            printf '%s: would report port %s unavailable, handshake never\n' "$name" "$actual_port"
        else
            printf '%s: would report port %s unavailable, handshake age %s seconds\n' "$name" "$actual_port" "$age"
        fi
        return
    fi
    coordinator_request PUT "/v1/channels/$name/failure" "{\"port\":$actual_port}"
    if (( handshake == 0 )); then
        printf '%s: reported port %s unavailable, handshake never\n' "$name" "$actual_port"
    else
        printf '%s: reported port %s unavailable, handshake age %s seconds\n' "$name" "$actual_port" "$age"
    fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    case ${1-}:${2-} in
        forward:set) shift; set_command "$@" ;;
        forward:get) shift; get_command "$@" ;;
        forward:del) shift; del_command "$@" ;;
        forward:list) shift; list_command "$@" ;;
        coordinator:set) shift; coordinator_set_command "$@" ;;
        coordinator:fail) shift; coordinator_fail_command "$@" ;;
        coordinator:get) shift; coordinator_get_command "$@" ;;
        coordinator:del) shift; coordinator_del_command "$@" ;;
        coordinator:list) shift; coordinator_list_command "$@" ;;
        server:*) server_command "$@" ;;
        client:*) client_command "$@" ;;
        *) usage; exit 2 ;;
    esac
fi
